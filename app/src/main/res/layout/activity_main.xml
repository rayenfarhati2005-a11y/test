<?xml version="1.0" encoding="utf-8"?>
<!-- Test Git -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">


    <TextView
        android:id="@+id/txt_titre_rf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DOUANE TEMPORELLE"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edt_nom_rf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur"/>

    <EditText
        android:id="@+id/edt_naissance_rf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de Naissance"
        android:inputType="number"/>

    <EditText
        android:id="@+id/edt_destination_rf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de Destination"
        android:inputType="number"/>

    <Spinner
        android:id="@+id/spinner_motif_rf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btn_inspecter_rf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inspecter le profil"/>

</LinearLayout>